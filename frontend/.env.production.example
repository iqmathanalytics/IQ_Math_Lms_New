# Copy values into Cloudflare Pages → Settings → Environment variables (Production).
# Do not put real secrets in git. VITE_* values are embedded in the browser bundle.

# API (Render behind api.iqmath.in)
VITE_API_URL=https://api.iqmath.in/api/v1

# Subpath on www.iqmath.in (must match Vite base + Worker mount)
VITE_BASE_PATH=/lms/

# Razorpay (live keys for production)
VITE_RAZORPAY_KEY_ID=your_live_razorpay_key_id
VITE_RAZORPAY_PAYLINK_URL=https://razorpay.me/iqmathtechnologies

# Firebase OTP (iqmath-lms) — also add www.iqmath.in to Authorized domains
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=iqmath-lms.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=iqmath-lms
VITE_FIREBASE_STORAGE_BUCKET=iqmath-lms.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
